{
  "name": "api-core",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "build": "tsc && node --input-type=module -e \"import { cpSync } from 'node:fs'; cpSync('src/data', 'dist/data', { recursive: true });\"",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "dev": "npm run build && npm start",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "express": "4.22.3"
  },
  "devDependencies": {
    "@types/express": "4.17.25",
    "@types/node": "24.19.1",
    "typescript": "5.9.3"
  }
}
